# Required for Live mode. Demo mode works without a key.
SERPAPI_KEY=your_serpapi_key_here

# Open-Source AI: Google Gemma 2 (Optional)
# Set ENABLE_LLM=false to use the deterministic evidence-backed rationale without contacting a model provider.
ENABLE_LLM=true
# If Ollama is running locally, it is auto-detected at http://127.0.0.1:11434
# Run: ollama run gemma2:9b (or gemma2:2b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma2:9b

# Or open-weight cloud API for Gemma (Groq / Google AI Studio)
# Google Gemma 2 Cloud API Key (from Google AI Studio)
GEMMA_API_KEY=your_gemma_api_key_here

# Server
PORT=8080
CORS_ORIGIN=http://localhost:5173
SERPAPI_TIMEOUT_MS=35000
